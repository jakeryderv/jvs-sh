{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jvs-sh",
  "compatibility_date": "2026-07-01",
  // Static assets only. There is no Worker script and no `main`.
  "assets": { "directory": "./public" },
  "workers_dev": false,
  "routes": [{ "pattern": "jvs.sh", "custom_domain": true }]
}
