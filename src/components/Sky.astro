<div class="sky" aria-hidden="true">
  <video
    id="background-video"
    data-src="/media/iss-background.mp4"
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    tabindex="-1"
    hidden
  ></video>
</div>

<script is:inline src="/scripts/background-video.js" defer></script>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg) url('/media/iss-poster.jpg') center / cover no-repeat;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Keep the horizon visible while shading the text at the top and bottom. */
  .sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.25) 50%, rgb(0 0 0 / 0.7));
  }

  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>
