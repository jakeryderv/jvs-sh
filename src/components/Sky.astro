---
// Fixed black backdrop with sparse stars and a gentle twinkle.
// Star positions are generated here at build time with a seeded PRNG, so the
// output is deterministic and no JavaScript ships to the browser.

function mulberry32(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// One box-shadow entry per star, positioned in viewport units so the field
// scales with the screen. Alpha varies so the field has depth.
function starfield(count: number, seed: number) {
  const rand = mulberry32(seed);
  const stars: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);
    const a = (0.2 + rand() * 0.45).toFixed(2);
    stars.push(`${x}vw ${y}vh 0 0 rgb(255 255 255 / ${a})`);
  }
  return stars.join(',');
}

const small = starfield(48, 1);
const distant = starfield(24, 3);
const large = starfield(8, 2);
---

<div class="sky" aria-hidden="true">
  <div class="stars small" style={`box-shadow: ${small}`}></div>
  <div class="stars distant" style={`box-shadow: ${distant}`}></div>
  <div class="stars large" style={`box-shadow: ${large}`}></div>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  /* Each star layer is a 1px element whose box-shadow list is the field. */
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: transparent;
    opacity: 0.8;
  }
  .stars.large {
    width: 1.5px;
    height: 1.5px;
  }

  /* Motion is opt-in; reduced motion keeps the same starfield completely still. */
  @media (prefers-reduced-motion: no-preference) {
    .stars.small {
      animation: twinkle 14s ease-in-out -5s infinite alternate;
    }
    .stars.distant {
      animation: twinkle 19s ease-in-out -12s infinite alternate-reverse;
    }
    .stars.large {
      animation: twinkle 23s ease-in-out -8s infinite alternate;
    }
  }

  @keyframes twinkle {
    from {
      opacity: 0.65;
    }
    to {
      opacity: 0.95;
    }
  }
</style>
