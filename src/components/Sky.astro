---
// Fixed full-viewport backdrop: a starfield with a slow aurora across the top.
// Star positions are generated here at build time with a seeded PRNG, so the
// output is deterministic and no JavaScript ships to the browser.

function mulberry32(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// One box-shadow entry per star, positioned in viewport units so the field
// scales with the screen. Alpha varies so the field has depth.
function starfield(count: number, seed: number) {
  const rand = mulberry32(seed);
  const stars: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);
    const a = (0.35 + rand() * 0.65).toFixed(2);
    stars.push(`${x}vw ${y}vh 0 0 rgb(255 255 255 / ${a})`);
  }
  return stars.join(',');
}

const small = starfield(160, 1);
const large = starfield(40, 2);
---

<div class="sky" aria-hidden="true">
  <div class="stars small" style={`box-shadow: ${small}`}></div>
  <div class="stars large" style={`box-shadow: ${large}`}></div>
  <div class="aurora">
    <span class="band a"></span>
    <span class="band b"></span>
    <span class="band c"></span>
  </div>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(ellipse 120% 80% at 50% -10%, #131a2a 0%, var(--bg) 65%);
  }

  /* Each star layer is a 1px element whose box-shadow list is the field. */
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: transparent;
  }
  .stars.small {
    animation: twinkle 6s ease-in-out infinite alternate;
  }
  .stars.large {
    width: 2px;
    height: 2px;
    animation: twinkle 9s ease-in-out infinite alternate-reverse;
  }

  /* Aurora: blurred gradient bands across the top third, fading out downward. */
  .aurora {
    position: absolute;
    inset: -10vh -10vw auto;
    height: 70vh;
    filter: blur(48px);
    opacity: 0.7;
    mix-blend-mode: screen;
    mask-image: linear-gradient(to bottom, black 10%, transparent 95%);
  }
  .band {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0;
    will-change: transform, opacity;
  }
  .band.a {
    background: radial-gradient(60% 45% at 30% 20%, rgb(45 212 191 / 0.55), transparent 70%);
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .band.b {
    background: radial-gradient(55% 40% at 65% 15%, rgb(52 211 153 / 0.45), transparent 70%);
    animation: drift-b 34s ease-in-out infinite alternate;
  }
  .band.c {
    background: radial-gradient(50% 35% at 50% 30%, rgb(139 92 246 / 0.3), transparent 70%);
    animation: drift-c 42s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes drift-a {
    from {
      transform: translateX(-6%) skewX(-8deg);
      opacity: 0.7;
    }
    to {
      transform: translateX(8%) skewX(6deg);
      opacity: 1;
    }
  }
  @keyframes drift-b {
    from {
      transform: translateX(6%) skewX(6deg) scaleY(0.9);
      opacity: 0.6;
    }
    to {
      transform: translateX(-8%) skewX(-10deg) scaleY(1.1);
      opacity: 1;
    }
  }
  @keyframes drift-c {
    from {
      transform: translateX(4%) scaleY(1.1);
      opacity: 0.5;
    }
    to {
      transform: translateX(-5%) scaleY(0.9);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars,
    .band {
      animation: none;
    }
  }
</style>
